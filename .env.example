# Local-only Ground Console environment template.
# Copy this file to .env and replace the placeholder manually.
# Never commit the real .env file or print its values to logs.
#
# SDR_DOA_ADMIN_PASSWORD unlocks admin in the console: branding, and the
# explicitly confirmed config-patch send to the Raspberry over MQTT.
# - Absent from both the process environment and .env: the default password
#   123456 applies and the console shows a warning. Set a real password.
# - Present but empty (SDR_DOA_ADMIN_PASSWORD=): admin login is disabled.
# - The process environment wins over this file.

SDR_DOA_ADMIN_PASSWORD=replace-with-a-local-admin-password
