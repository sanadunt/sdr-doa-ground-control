# SDR-DoA edge agent for the RDF-SDR (Raspberry), as a container.
#
# On the Raspberry (from the repository or the unpacked agent release):
#   docker compose -f docker-compose.agent.yml up -d --build   # repository
#   docker compose up -d --build                               # agent release
# Cross-build on another machine:
#   docker buildx build --platform linux/arm64,linux/arm/v7 -f Dockerfile.agent -t sdr-doa-agent:2.0.0 .
#
# The agent uses only the Python standard library and this file has no RUN
# step, so a cross-build needs no emulation. Run it with the host network
# (--network host, network_mode: host): 127.0.0.1 must reach KrakenSDR Data Out
# on port 8081 and a broker on the Raspberry. Settings are the agent.env
# variables (packaging/agent/agent.env.example), passed as environment.

ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE}
LABEL org.opencontainers.image.title="SDR-DoA RDF-SDR edge agent" \
      org.opencontainers.image.description="Publishes RDF-SDR Data Out health and config over MQTT; run with the host network" \
      org.opencontainers.image.source="https://github.com/sanadunt/sdr-doa-ground-control"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SDR_DOA_AGENT_HOME=/opt/sdr-doa-agent \
    SDR_DOA_AGENT_PYTHON=python3 \
    BASE_URL=http://127.0.0.1:8081 \
    MQTT_HOST=127.0.0.1 \
    MQTT_PORT=1883 \
    PUBLISH=1 \
    ENABLE_CONFIG=0 \
    SETTINGS_PATH=/krakensdr/_share/settings.json \
    STATE_DIR=/state
COPY VERSION /opt/sdr-doa-agent/
COPY tools/sdr_doa_collector.py tools/sdr_doa_lan_agent.py tools/sdr_doa_mqtt.py tools/sdr_doa_mqtt_stdlib.py /opt/sdr-doa-agent/tools/
COPY --chmod=0755 packaging/agent/run-agent.sh /opt/sdr-doa-agent/bin/run-agent
USER 10001:10001
# Created by WORKDIR for the user above, so a new named volume is writable.
WORKDIR /state
VOLUME ["/state"]
ENTRYPOINT ["/opt/sdr-doa-agent/bin/run-agent"]
