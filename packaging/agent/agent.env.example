# Settings of the SDR-DoA edge agent on the RDF-SDR (Raspberry).
# Native install: /etc/sdr-doa-agent/agent.env, read by the sdr-doa-agent
# service. Apply a change with: sudo systemctl restart sdr-doa-agent
# Docker: copy to agent.env next to docker-compose.yml (STATE_DIR and
# SETTINGS_PATH are set by the compose file there).
# Keep it owner root, group of the service user, mode 0640: it may hold the
# MQTT password. Empty values use the agent's defaults.

# KrakenSDR Data Out on this Raspberry.
BASE_URL=http://127.0.0.1:8081

# MQTT broker. The agent speaks MQTT 3.1.1 over TCP, not WebSocket. A broker
# that is not on loopback needs TLS (MQTT_TLS=1, or a CA file in MQTT_CAFILE)
# and a username; the password goes in SDR_DOA_MQTT_PASSWORD.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TLS=0
MQTT_CAFILE=
MQTT_USERNAME=
SDR_DOA_MQTT_PASSWORD=

# 1: publish health, state and config_reported (Kontrol needs them). 0: no MQTT.
PUBLISH=1
# 1: apply Kontrol config patches to SETTINGS_PATH (needs PUBLISH=1).
# 0: answer every patch with REMOTE_CONTROL_DISABLED.
ENABLE_CONFIG=0
# KrakenSDR settings.json: the base of the config revision, written only with
# ENABLE_CONFIG=1.
SETTINGS_PATH=/home/doasdr/doasdr/_share/settings.json
# Agent state (config revision). Keep it across upgrades.
STATE_DIR=/var/lib/sdr-doa-agent

# Optional tuning. CLOCK_SOURCE: local or remote_unverified.
# AUTHORITY: none, csv or xml (with none the agent publishes no DoA).
CLOCK_SOURCE=local
AUTHORITY=
HEALTH_INTERVAL=
DOA_RATE=
STATE_INTERVAL=
POLL_INTERVAL=
COLLECT_BUDGET=
