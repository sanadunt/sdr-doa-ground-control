# systemd user service of the SDR-DoA Ground Console, installed by install.sh.
# Control it with sdr-doa-console (start|stop|restart|status|logs|open).
# Saved settings live in @DATA_DIR@; seed.env there only matters until the
# first start has written console.json.
[Unit]
Description=SDR-DoA Ground Console (http://127.0.0.1:@PORT@/)
Documentation=file://@APP_DIR@/README.md

[Service]
Type=simple
EnvironmentFile=-@DATA_DIR@/seed.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/venv/bin/python @APP_DIR@/tools/ground_console.py --bind 127.0.0.1 --port @PORT@ --config-path @DATA_DIR@/console.json --branding-path @DATA_DIR@/branding.json --preferences-path @DATA_DIR@/preferences.json --data-dir @DATA_DIR@/receiver --tile-cache-dir @DATA_DIR@/tiles --env-file @DATA_DIR@/.env
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
