#!/usr/bin/env python3
# ground-gps-publisher (packaging/ground-gps): the groundstation's own position.
#
# Reads the NMEA 0183 output of the groundstation's GNSS receiver (a u-blox 7
# on USB, /dev/ttyACM0) and publishes its status, retained, to the local MQTT
# broker on sdr/v2/<node>/ground/gps, where the SDR-DoA Ground Console reads
# it. Python 3 standard library only.
#
#   ground-gps-publisher run [--config FILE]        # the service
#   ground-gps-publisher print [--count N]          # read the receiver, print the status, publish nothing
#   ground-gps-publisher check-config [--config FILE]
#
# The device is opened read only and the publisher never writes to it: the
# only change it makes to the tty is clearing ECHO (the line discipline would
# otherwise send every received byte back to the receiver) and, when BAUD is
# set, the speed. On the very first open of a new ttyACM the kernel may echo
# the few bytes that arrive before ECHO is cleared; the u-blox ignores them.
"""Publish the groundstation GNSS position to the local MQTT broker."""

from __future__ import annotations

import argparse
import datetime
import errno
import ipaddress
import json
import math
import os
import re
import select
import signal
