# The loop


class Publisher:
    def __init__(self, config: Dict[str, object], *, wall_ms: Optional[Callable[[], int]] = None,
                 monotonic: Callable[[], float] = time.monotonic, mqtt: Optional[MqttClient] = None,
                 emit: Optional[Callable[[bytes], None]] = None, backoff_first: float = BACKOFF_FIRST_S,
                 backoff_max: float = BACKOFF_MAX_S) -> None:
        self.config = config
        self.path = str(config["device"])
        self.device = device_label(self.path)
        self.topic = topic_for(str(config["node"]))
        self.interval = float(config["interval"])  # type: ignore[arg-type]
        self.wall_ms = wall_ms or (lambda: int(time.time() * 1000))
        self.monotonic = monotonic
        self.mqtt = mqtt
        # print mode: each payload goes to emit instead of the broker.
        self.emit = emit
        self.backoff_first = backoff_first
        self.backoff_max = backoff_max
        self.tracker = GpsTracker()
        self.fd: Optional[int] = None
        self.device_state: Tuple[str, Optional[str]] = ("NO_DEVICE", None)
        self.next_open = 0.0
        self.next_publish = 0.0
        self.next_connect = 0.0
        self.backoff = backoff_first
        self.last_key: Optional[Tuple[object, ...]] = None
        self.last_logged_device: Optional[Tuple[str, Optional[str]]] = None
        self.connect_failures = 0
        self.published = 0

    # The device side.

    def try_open(self, now: float) -> None:
        try:
            self.fd = open_device(self.path, self.config.get("baud"))  # type: ignore[arg-type]
        except OSError as error:
            self.fd = None
            self.device_state = device_error(error)
            self.next_open = now + DEVICE_RETRY_S
            if self.device_state != self.last_logged_device:
                text = self.device_state[1] or "not found"
                log(f"{self.path}: {text}; trying again every {DEVICE_RETRY_S:g} s")
                self.last_logged_device = self.device_state
            return
        self.tracker.reset(now)
        self.device_state = ("OPEN", None)
        self.last_logged_device = None
        log(f"reading {self.path} (read only)")

    def close_device(self, now: float, why: str) -> None:
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
        self.fd = None
        self.device_state = ("NO_DEVICE", None)
        self.next_open = now + DEVICE_RETRY_S
        log(f"{self.path}: {why}")

    def read_device(self, now: float) -> None:
        # A tty in canonical mode hands out one line per read: take what is
        # waiting, a bounded amount per turn.
        for _ in range(READS_PER_TURN):
            if self.fd is None:
                return
            try:
                data = os.read(self.fd, 4096)
            except (BlockingIOError, InterruptedError):
                return
            except OSError as error:
                # EIO: the receiver was unplugged.
                self.close_device(now, f"read failed ({os.strerror(error.errno) if error.errno else error})")
                return
            if not data:
                self.close_device(now, "the device went away")
                return
            self.tracker.feed(data, now)

    def status(self, now: float) -> Dict[str, object]:
        state, error = self.device_state
        if state == "OPEN":
            values = self.tracker.status(now)
            return build_payload(self.wall_ms(), str(values["state"]), self.device, values)
        return build_payload(self.wall_ms(), state, self.device, None, error)

    # The broker side.

    def ensure_connected(self, now: float) -> None:
        if self.mqtt is None or self.mqtt.connected or now < self.next_connect:
            return
        try:
            self.mqtt.connect()
        except (OSError, MqttError) as error:
            self.connect_failures += 1
            if self.connect_failures == 1 or self.backoff >= self.backoff_max:
                log(f"broker {self.mqtt.host}:{self.mqtt.port}: {error}; trying again in {self.backoff:g} s")
            self.next_connect = now + self.backoff
            self.backoff = min(self.backoff * 2, self.backoff_max)
            return
        log(f"connected to {self.mqtt.host}:{self.mqtt.port} as {self.mqtt.client_id}, publishing {self.topic}")
        self.connect_failures = 0
        self.backoff = self.backoff_first
        # The retained status is current again at once.
        self.next_publish = now

    def lost(self, now: float, error: Exception) -> None:
        log(f"broker connection lost: {error}; trying again in {self.backoff_first:g} s")
        self.next_connect = now + self.backoff_first
        self.backoff = self.backoff_first

    def send(self, payload: Dict[str, object]) -> None:
        data = encode_payload(payload)
        if self.emit is not None:
            self.emit(data)
            self.published += 1
            return
        if self.mqtt is None or not self.mqtt.connected:
            return
        self.mqtt.publish(self.topic, data, retain=True)
        self.published += 1

    def step(self, timeout: float = 0.5) -> None:
        """One turn: open, read, keep the connection, publish when due or when the fix changes."""
        now = self.monotonic()
        if self.fd is None and now >= self.next_open:
            self.try_open(now)
        self.ensure_connected(now)
        readers: List[int] = []
        if self.fd is not None:
            readers.append(self.fd)
        if self.mqtt is not None and self.mqtt.connected:
            readers.append(self.mqtt.fileno())
        wait = max(0.0, min(timeout, self.next_publish - now)) if self.next_publish > now else 0.0
        if readers:
            try:
                ready, _, _ = select.select(readers, [], [], wait)
            except InterruptedError:
                ready = []
        else:
            time.sleep(wait)
            ready = []
        now = self.monotonic()
        if self.fd is not None and self.fd in ready:
            self.read_device(now)
        if self.mqtt is not None and self.mqtt.connected and self.mqtt.fileno() in ready:
            try:
                self.mqtt.on_readable()
            except MqttError as error:
                self.lost(now, error)
        payload = self.status(now)
        key = (payload["state"], payload["fix"], payload["error"])
        if key != self.last_key:
            log(f"state {payload['state']}" + (f" fix {payload['fix']}D" if payload["state"] == "FIX" else "")
                + (f": {payload['error']}" if payload["error"] else ""))
            self.next_publish = now
        if now >= self.next_publish:
            try:
                self.send(payload)
                self.last_key = key
            except MqttError as error:
                self.lost(now, error)
            self.next_publish = now + self.interval
        if self.mqtt is not None and self.mqtt.connected:
            try:
                self.mqtt.tick()
            except MqttError as error:
                self.lost(now, error)

    def run(self, should_stop: Callable[[], bool] = lambda: False, max_steps: Optional[int] = None) -> None:
        steps = 0
        try:
            while not should_stop():
                self.step()
                steps += 1
                if max_steps is not None and steps >= max_steps:
                    break
        finally:
            self.finish()

    def finish(self) -> None:
        """A last retained STOPPED, then DISCONNECT, so the console does not wait for STALE."""
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
        if self.emit is None and self.mqtt is not None:
            if self.mqtt.connected:
                try:
                    self.send(build_payload(self.wall_ms(), "STOPPED", self.device))
                except MqttError:
                    pass
            self.mqtt.disconnect()


# ---------------------------------------------------------------------------
# Command line


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="ground-gps-publisher", description=__doc__)
    parser.add_argument("command", nargs="?", default="run", choices=("run", "print", "check-config"))
    parser.add_argument("--config", default=None, help=f"settings file (default {DEFAULT_CONFIG} when it exists)")
    parser.add_argument("--device", help="override DEVICE")
    parser.add_argument("--count", type=int, default=5, help="print: how many statuses (default 5)")
    args = parser.parse_args(argv)
    try:
        config = load_config(args.config if args.config is not None else DEFAULT_CONFIG)
        if args.device:
            config = validate_config(dict(DEFAULTS, DEVICE=args.device, BROKER_HOST=str(config["host"]),
                                          BROKER_PORT=str(config["port"]), NODE_ID=str(config["node"]),
                                          INTERVAL=str(config["interval"]),
                                          BAUD="" if config["baud"] is None else str(config["baud"])))
    except ConfigError as error:
        log(f"ground-gps-publisher: {error}")
        return EX_CONFIG

    if args.command == "check-config":
        print(f"DEVICE={config['device']}")
        print(f"BROKER_HOST={config['host']}")
        print(f"BROKER_PORT={config['port']}")
        print(f"NODE_ID={config['node']}")
        print(f"INTERVAL={config['interval']:g}")
        print(f"BAUD={'' if config['baud'] is None else config['baud']}")
        print(f"TOPIC={topic_for(str(config['node']))}")
        return 0

    stop = {"flag": False}

    def request_stop(signum: int, frame: object) -> None:
        stop["flag"] = True

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)

    if args.command == "print":
        def emit(data: bytes) -> None:
            print(data.decode("ascii"), flush=True)

        publisher = Publisher(config, emit=emit)
        publisher.interval = min(publisher.interval, 2.0)
        publisher.run(lambda: stop["flag"] or publisher.published >= max(1, args.count))
        return 0

    mqtt = MqttClient(str(config["host"]), int(config["port"]),  # type: ignore[arg-type]
                      client_id_for(socket.gethostname()))
    publisher = Publisher(config, mqtt=mqtt)
    log(f"ground-gps-publisher: {config['device']} -> {config['host']}:{config['port']} {publisher.topic}")
    publisher.run(lambda: stop["flag"])
    log("stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
