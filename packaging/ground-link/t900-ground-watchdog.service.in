# Written by the t900-ground-link installer (packaging/ground-link/install.sh).
# One check of the T900 PPP link; t900-ground-watchdog.timer starts it every
# 30 s. Settings: /etc/t900-ground-link/link.conf. Journal: journalctl -t t900-ground-watchdog
[Unit]
Description=T900 PPP link watchdog (one check)
Documentation=file://@SHARE_DIR@/README.md
After=@PPP_SERVICE@

[Service]
Type=oneshot
# Root: it restarts @PPP_SERVICE@, resets the USB device and may switch
# its power. It opens no port.
ExecStart=@SBIN_DIR@/t900-ground-watchdog check
SyslogIdentifier=t900-ground-watchdog
StateDirectory=t900-ground-link
StateDirectoryMode=0755
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
